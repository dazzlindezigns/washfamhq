# ---- Required ----
# Supabase project (Settings -> API). Shared project is fine; everything we create is prefixed xmas_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the RSVP API routes and /admin. NEVER expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Passcode for /admin
ADMIN_PASSCODE=

# ---- Recommended ----
# Canonical URL for share previews, no trailing slash (e.g. https://gamenight.example.com)
NEXT_PUBLIC_SITE_URL=
# Your phone/text number, shown as "Text Dani" links. Leave empty to hide them.
HOST_PHONE=

# ---- Optional ----
# Signs the admin cookie. If empty, a key is derived from ADMIN_PASSCODE.
ADMIN_SESSION_SECRET=
# New-RSVP email alerts (all three; leave RESEND_API_KEY empty to turn alerts off)
RESEND_API_KEY=
RSVP_NOTIFY_EMAIL=
# Must be a sender on a domain you verified in Resend. Defaults to Resend's test sender.
RESEND_FROM=
